<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudebot.youtube-ripper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/youtube-ripper/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/youtube-ripper</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/claudebot-youtube-ripper.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/claudebot-youtube-ripper-error.log</string>
</dict>
</plist>
